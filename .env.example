# OpenAI - https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
# Optional: override the text model (default gpt-4o)
OPENAI_MODEL=gpt-4o

# Clerk - https://dashboard.clerk.com (API Keys page)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# Postgres - added automatically when you connect Neon storage in Vercel.
# For local dev, copy the connection string from Vercel > Storage > your database.
POSTGRES_URL=postgres://...
